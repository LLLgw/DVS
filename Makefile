####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/DVS/bin || mkdir -p $(INSTALL_ROOT)/opt/DVS/bin
	$(QINSTALL_PROGRAM) build/bin/$(QMAKE_TARGET) $(INSTALL_ROOT)/opt/DVS/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/DVS/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/DVS/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

